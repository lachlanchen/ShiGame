{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shi.game/schema/audio-v1.json",
  "title": "SHI procedural audio contract v1",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "synthesis", "mix", "envelope", "ambience", "cues", "quality"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "synthesis": { "const": "project-original-procedural" },
    "mix": {
      "type": "object",
      "required": ["defaults", "caps", "fadeSeconds"],
      "properties": {
        "defaults": { "$ref": "#/$defs/mixValues" },
        "caps": { "$ref": "#/$defs/mixValues" },
        "fadeSeconds": { "type": "number", "minimum": 0.05, "maximum": 3 }
      },
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "required": ["attackMs", "releaseMs", "curve"],
      "properties": {
        "attackMs": { "type": "number", "minimum": 1, "maximum": 50 },
        "releaseMs": { "type": "number", "minimum": 1, "maximum": 100 },
        "curve": { "const": "linear" }
      },
      "additionalProperties": false
    },
    "ambience": {
      "type": "object",
      "required": ["id", "seed", "sampleRate", "loopSeconds", "highpassHz", "lowpassHz", "gain"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "seed": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "sampleRate": { "type": "integer", "minimum": 16000, "maximum": 48000 },
        "loopSeconds": { "type": "integer", "minimum": 2, "maximum": 30 },
        "highpassHz": { "type": "number", "minimum": 20, "maximum": 1000 },
        "lowpassHz": { "type": "number", "minimum": 1000, "maximum": 12000 },
        "gain": { "type": "number", "minimum": 0, "maximum": 0.5 }
      },
      "additionalProperties": false
    },
    "cues": {
      "type": "object",
      "required": ["select", "inspect", "drawer", "close", "commit", "ending", "failure"],
      "properties": {
        "select": { "$ref": "#/$defs/cue" },
        "inspect": { "$ref": "#/$defs/cue" },
        "drawer": { "$ref": "#/$defs/cue" },
        "close": { "$ref": "#/$defs/cue" },
        "commit": { "$ref": "#/$defs/cue" },
        "ending": { "$ref": "#/$defs/cue" },
        "failure": { "$ref": "#/$defs/cue" }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["reference", "browserCapture", "limits"],
      "properties": {
        "reference": {
          "type": "object",
          "required": ["sampleRate", "seconds", "cueSchedule"],
          "properties": {
            "sampleRate": { "type": "integer", "minimum": 44100, "maximum": 96000 },
            "seconds": { "type": "number", "minimum": 10, "maximum": 60 },
            "cueSchedule": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "object",
                "required": ["cue", "atSeconds"],
                "properties": {
                  "cue": { "enum": ["select", "inspect", "drawer", "close", "commit", "ending", "failure"] },
                  "atSeconds": { "type": "number", "minimum": 0, "maximum": 60 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "browserCapture": {
          "type": "object",
          "required": ["sampleRate", "preConsentSeconds", "activeSeconds"],
          "properties": {
            "sampleRate": { "type": "integer", "minimum": 44100, "maximum": 96000 },
            "preConsentSeconds": { "type": "number", "minimum": 1, "maximum": 10 },
            "activeSeconds": { "type": "number", "minimum": 14, "maximum": 60 }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "required": ["samplePeakDbfsMax", "truePeakDbtpMax", "integratedLufsMin", "integratedLufsMax", "cuePeakDbfsMin", "dcOffsetAbsoluteMax", "rawAmbienceDcOffsetAbsoluteMax", "loopBoundaryJumpRatioMax", "stereoDifferenceRmsMax"],
          "properties": {
            "samplePeakDbfsMax": { "type": "number", "minimum": -30, "maximum": -1 },
            "truePeakDbtpMax": { "type": "number", "minimum": -30, "maximum": -1 },
            "integratedLufsMin": { "type": "number", "minimum": -60, "maximum": -10 },
            "integratedLufsMax": { "type": "number", "minimum": -60, "maximum": -10 },
            "cuePeakDbfsMin": { "type": "number", "minimum": -60, "maximum": -10 },
            "dcOffsetAbsoluteMax": { "type": "number", "minimum": 0, "maximum": 0.01 },
            "rawAmbienceDcOffsetAbsoluteMax": { "type": "number", "minimum": 0, "maximum": 0.01 },
            "loopBoundaryJumpRatioMax": { "type": "number", "minimum": 0, "maximum": 2 },
            "stereoDifferenceRmsMax": { "type": "number", "minimum": 0, "maximum": 0.01 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "mixValues": {
      "type": "object",
      "required": ["master", "ambience", "effects"],
      "properties": {
        "enabled": { "type": "boolean" },
        "master": { "type": "number", "minimum": 0, "maximum": 1 },
        "ambience": { "type": "number", "minimum": 0, "maximum": 1 },
        "effects": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "tone": {
      "type": "object",
      "required": ["offsetMs", "frequencyHz", "endFrequencyHz", "durationMs", "gain", "wave"],
      "properties": {
        "offsetMs": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "frequencyHz": { "type": "number", "minimum": 80, "maximum": 1600 },
        "endFrequencyHz": { "type": "number", "minimum": 80, "maximum": 1600 },
        "durationMs": { "type": "integer", "minimum": 20, "maximum": 1000 },
        "gain": { "type": "number", "minimum": 0.001, "maximum": 0.15 },
        "wave": { "enum": ["sine", "triangle"] }
      },
      "additionalProperties": false
    },
    "cue": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/tone" }
    }
  },
  "additionalProperties": false
}
