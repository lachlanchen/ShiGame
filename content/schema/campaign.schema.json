{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shi.game/schema/campaign-v7.json",
  "title": "SHI Campaign v7",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "subtitle", "startNodeId", "acts", "initialResources", "commitments", "opposition", "sites", "characters", "sources", "claims", "nodes"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "$ref": "#/$defs/localizedText" },
    "subtitle": { "$ref": "#/$defs/localizedText" },
    "startNodeId": { "type": "string" },
    "acts": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/campaignAct" } },
    "initialResources": { "$ref": "#/$defs/resources" },
    "commitments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/commitment" } },
    "opposition": { "$ref": "#/$defs/opposition" },
    "sites": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/site" } },
    "characters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/character" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
  },
  "additionalProperties": false,
  "$defs": {
    "campaignAct": {
      "type": "object",
      "required": ["id", "title", "objective"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "$ref": "#/$defs/localizedText" },
        "objective": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    },
    "localizedText": {
      "type": "object",
      "required": ["en", "zh-Hans"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ar": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 },
        "fr": { "type": "string", "minLength": 1 },
        "ja": { "type": "string", "minLength": 1 },
        "ko": { "type": "string", "minLength": 1 },
        "ru": { "type": "string", "minLength": 1 },
        "vi": { "type": "string", "minLength": 1 },
        "zh-Hans": { "type": "string", "minLength": 1 },
        "zh-Hant": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["grain", "trust", "momentum", "people", "danger"],
      "properties": {
        "grain": { "type": "number", "minimum": 0, "maximum": 100 },
        "trust": { "type": "number", "minimum": 0, "maximum": 100 },
        "momentum": { "type": "number", "minimum": 0, "maximum": 100 },
        "people": { "type": "number", "minimum": 0, "maximum": 100 },
        "danger": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "resourceEffects": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "grain": { "type": "number", "minimum": -100, "maximum": 100 },
        "trust": { "type": "number", "minimum": -100, "maximum": 100 },
        "momentum": { "type": "number", "minimum": -100, "maximum": 100 },
        "people": { "type": "number", "minimum": -100, "maximum": 100 },
        "danger": { "type": "number", "minimum": -100, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "optionalResourceEffects": {
      "type": "object",
      "properties": {
        "grain": { "type": "number", "minimum": -4, "maximum": 4 },
        "trust": { "type": "number", "minimum": -4, "maximum": 4 },
        "momentum": { "type": "number", "minimum": -4, "maximum": 4 },
        "people": { "type": "number", "minimum": -4, "maximum": 4 },
        "danger": { "type": "number", "minimum": -4, "maximum": 4 }
      },
      "additionalProperties": false
    },
    "resourceRequirements": {
      "type": "object",
      "properties": {
        "grain": { "type": "number", "minimum": 0, "maximum": 100 },
        "trust": { "type": "number", "minimum": 0, "maximum": 100 },
        "momentum": { "type": "number", "minimum": 0, "maximum": 100 },
        "people": { "type": "number", "minimum": 0, "maximum": 100 },
        "danger": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "opposition": {
      "type": "object",
      "required": ["id", "claimStatus", "title", "description", "methods", "methodRead", "stages"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "claimStatus": { "const": "dramatic-reconstruction" },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "methods": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/strategicMethod" } },
        "methodRead": { "$ref": "#/$defs/methodRead" },
        "stages": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/oppositionStage" } }
      },
      "additionalProperties": false
    },
    "strategicMethod": {
      "type": "object",
      "required": ["id", "title", "reading"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "$ref": "#/$defs/localizedText" },
        "reading": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    },
    "methodRead": {
      "type": "object",
      "required": ["claimStatus", "minimumObservations", "title", "description", "neutral", "countermeasures"],
      "properties": {
        "claimStatus": { "const": "dramatic-reconstruction" },
        "minimumObservations": { "type": "integer", "minimum": 2, "maximum": 10 },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "neutral": { "$ref": "#/$defs/methodReadNeutral" },
        "countermeasures": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/methodCountermeasure" } }
      },
      "additionalProperties": false
    },
    "methodReadNeutral": {
      "type": "object",
      "required": ["id", "title", "forecast", "response", "counterplay"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "$ref": "#/$defs/localizedText" },
        "forecast": { "$ref": "#/$defs/localizedText" },
        "response": { "$ref": "#/$defs/localizedText" },
        "counterplay": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    },
    "methodCountermeasure": {
      "type": "object",
      "required": ["id", "targetMethodId", "title", "forecast", "hitResponse", "missResponse", "counterplay", "effects"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "targetMethodId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "$ref": "#/$defs/localizedText" },
        "forecast": { "$ref": "#/$defs/localizedText" },
        "hitResponse": { "$ref": "#/$defs/localizedText" },
        "missResponse": { "$ref": "#/$defs/localizedText" },
        "counterplay": { "$ref": "#/$defs/localizedText" },
        "effects": { "$ref": "#/$defs/optionalResourceEffects" }
      },
      "additionalProperties": false
    },
    "oppositionStage": {
      "type": "object",
      "required": ["id", "minDanger", "maxDanger", "title", "forecast", "response", "counterplay", "effects"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "minDanger": { "type": "integer", "minimum": 0, "maximum": 99 },
        "maxDanger": { "type": "integer", "minimum": 0, "maximum": 99 },
        "title": { "$ref": "#/$defs/localizedText" },
        "forecast": { "$ref": "#/$defs/localizedText" },
        "response": { "$ref": "#/$defs/localizedText" },
        "counterplay": { "$ref": "#/$defs/localizedText" },
        "effects": { "$ref": "#/$defs/optionalResourceEffects" }
      },
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "required": ["id", "name", "x", "z", "status", "summary", "uncertainty", "sourceRefs", "claimRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "x": { "type": "number" },
        "z": { "type": "number" },
        "status": { "enum": ["known", "reported", "reference"] },
        "summary": { "$ref": "#/$defs/localizedText" },
        "uncertainty": { "$ref": "#/$defs/localizedText" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "claimRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "required": ["id", "name", "role", "historical"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/localizedText" },
        "role": { "$ref": "#/$defs/localizedText" },
        "historical": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "editionId", "work", "section", "locator", "note", "claimStatus", "rightsStatus"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "editionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "work": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "author": { "type": "string" },
        "date": { "type": "string" },
        "note": { "$ref": "#/$defs/localizedText" },
        "claimStatus": { "enum": ["received-account", "later-compilation", "strategic-text", "dramatic-reconstruction"] },
        "rightsStatus": { "enum": ["public-link-metadata-only", "project-original"] }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["id", "kind", "statement", "sourceRefs", "reviewStatus", "confidence", "uncertainty", "gameUse", "reviewer"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["chronology", "event", "institution", "person", "geography", "strategic-lens", "reconstruction"] },
        "statement": { "$ref": "#/$defs/localizedText" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "reviewStatus": { "enum": ["evidence-located", "specialist-review-required", "authored-reconstruction"] },
        "confidence": { "enum": ["high", "medium", "low", "not-applicable"] },
        "uncertainty": { "$ref": "#/$defs/localizedText" },
        "gameUse": { "$ref": "#/$defs/localizedText" },
        "reviewer": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "pressure": {
      "type": "object",
      "required": ["kind", "warning", "reveal", "effects"],
      "properties": {
        "kind": { "enum": ["state", "terrain", "supply", "network"] },
        "warning": { "$ref": "#/$defs/localizedText" },
        "reveal": { "$ref": "#/$defs/localizedText" },
        "effects": { "$ref": "#/$defs/resourceEffects" }
      },
      "additionalProperties": false
    },
    "commitmentOutcome": {
      "type": "object",
      "required": ["id", "choiceId", "status", "forecast", "response", "effects"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "choiceId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "status": { "enum": ["kept", "strained", "broken"] },
        "forecast": { "$ref": "#/$defs/localizedText" },
        "response": { "$ref": "#/$defs/localizedText" },
        "effects": { "$ref": "#/$defs/optionalResourceEffects" }
      },
      "additionalProperties": false
    },
    "commitment": {
      "type": "object",
      "required": ["id", "claimStatus", "establishedByChoiceId", "stakeholderId", "title", "promise", "outcomes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "claimStatus": { "const": "dramatic-reconstruction" },
        "establishedByChoiceId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "stakeholderId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "$ref": "#/$defs/localizedText" },
        "promise": { "$ref": "#/$defs/localizedText" },
        "outcomes": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/commitmentOutcome" } }
      },
      "additionalProperties": false
    },
    "fieldCondition": {
      "type": "object",
      "required": ["id", "claimStatus", "title", "signal", "weight", "effects"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "claimStatus": { "const": "dramatic-reconstruction" },
        "title": { "$ref": "#/$defs/localizedText" },
        "signal": { "$ref": "#/$defs/localizedText" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "effects": { "$ref": "#/$defs/resourceEffects" }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "properties": {
        "min": { "$ref": "#/$defs/resourceRequirements" },
        "max": { "$ref": "#/$defs/resourceRequirements" }
      },
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "required": ["id", "methodId", "label", "intent", "consequence", "strategy", "effects"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "methodId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "$ref": "#/$defs/localizedText" },
        "intent": { "$ref": "#/$defs/localizedText" },
        "consequence": { "$ref": "#/$defs/localizedText" },
        "strategy": { "$ref": "#/$defs/localizedText" },
        "effects": { "$ref": "#/$defs/resourceEffects" },
        "requirements": { "$ref": "#/$defs/requirements" },
        "pressure": { "$ref": "#/$defs/pressure" },
        "flags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "nextNodeId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "actId", "timeIndex", "dateLabel", "siteId", "speakerId", "title", "context", "dialogue", "sourceRefs", "claimRefs", "conditions", "choices"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "actId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "timeIndex": { "type": "integer", "minimum": 0 },
        "dateLabel": { "$ref": "#/$defs/localizedText" },
        "siteId": { "type": "string", "minLength": 1 },
        "speakerId": { "type": "string", "minLength": 1 },
        "title": { "$ref": "#/$defs/localizedText" },
        "context": { "$ref": "#/$defs/localizedText" },
        "dialogue": { "$ref": "#/$defs/localizedText" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "claimRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "conditions": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/fieldCondition" } },
        "choices": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/choice" } }
      },
      "additionalProperties": false
    }
  }
}
