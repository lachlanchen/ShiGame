  m_AmbientGroundColor: {r: 0.025, g: 0.027, b: 0.024, a: 1}
  m_AmbientIntensity: 0.75
  m_AmbientMode: 3
  m_SubtractiveShadowColor: {r: 0.25, g: 0.23, b: 0.2, a: 1}
  m_SkyboxMaterial: {fileID: 0}
  m_HaloStrength: 0.5
  m_FlareStrength: 1
  m_FlareFadeSpeed: 3
  m_DefaultReflectionMode: 0
